# 1Router site configuration
#
# Self-hosted mode: provide your own PostgreSQL database and Better Auth secret.
# Managed mode: use managed PostgreSQL and set the Stripe variables as well.
# Never expose any of these variables with a NEXT_PUBLIC_ prefix.

# Deployment mode controls managed-only features. Use self-hosted locally.
DEPLOYMENT_MODE=self-hosted

# Better Auth persistence and canonical site URL.
# The self-hosted compose file publishes PostgreSQL on host port 5433 by default.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/onerouter
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# Passwordless authentication. Add OAuth credentials only for providers you enable.
# Google redirect: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# GitHub callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=false
# Cloudflare Email Sending works directly from Coolify via its REST API.
# Requires Workers Paid and an onboarded sending domain, e.g. auth.example.com.
# All values stay server-only. AUTH_EMAIL_FROM must be a plain email address.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
AUTH_EMAIL_FROM=login@auth.example.com

# Require a Better Auth session or generated API key for the browser/API proxy.
# Set true for a managed service; false keeps an anonymous self-hosted demo possible.
AUTH_REQUIRED=false

# Rust router upstream used by the same-origin site proxy.
# Self-hosted/managed deployments default to the shared 1Router gateway.
# For local full-stack development, scripts/dev.ts overrides this to localhost:3001.
ROUTER_API_URL=https://api.1router.com
# Master key used only between the site proxy and the Rust gateway.
# Set a valid key for the selected gateway. router_sk_test is only for local bun run dev.
ROUTER_API_KEY=router_sk_test
# Shared HMAC secret for the short-lived authenticated identity assertion.
# Set the same value as ROUTER_IDENTITY_SECRET in the gateway deployment.
ROUTER_IDENTITY_SECRET=replace-with-a-second-32-character-secret
# Gateway resilience. Deployments can be weighted per logical model.
ROUTER_MAX_RETRIES=2
ROUTER_DEPLOYMENTS_JSON={}
CHAT_RATE_LIMIT_PER_MINUTE=10
# Legacy fallback quota for users without an explicit policy. 0 disables it.
# Per-user, API-key, and organization policies are managed from /account.
ROUTER_REQUESTS_PER_DAY=0
# Optional default pricing in microdollars per 1,000 tokens when the model
# price table has no matching row. Model-specific prices live in
# router_model_prices after migration 003.
ROUTER_DEFAULT_INPUT_MICRODOLLARS_PER_1K=0
ROUTER_DEFAULT_OUTPUT_MICRODOLLARS_PER_1K=0
# Run `bun run --cwd apps/site jobs` once, or set this in a worker deployment.
CONTROL_PLANE_JOB_INTERVAL_SECONDS=0

# Optional enterprise OIDC. Set all three values to show the SSO button.
# The callback is /api/auth/oauth2/callback/enterprise-oidc.
ENTERPRISE_OIDC_ISSUER=
ENTERPRISE_OIDC_CLIENT_ID=
ENTERPRISE_OIDC_CLIENT_SECRET=
NEXT_PUBLIC_ENTERPRISE_SSO_ENABLED=false

# Optional managed-service billing. Leave all three unset for self-hosting.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
