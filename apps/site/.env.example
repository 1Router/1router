# 1Router site configuration
#
# Self-hosted mode: provide your own PostgreSQL database and Better Auth secret.
# Managed mode: use managed PostgreSQL and set the Stripe variables as well.
# Never expose any of these variables with a NEXT_PUBLIC_ prefix.

# Deployment mode controls managed-only features. Use self-hosted locally.
DEPLOYMENT_MODE=self-hosted

# Better Auth persistence and canonical site URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onerouter
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# Require a Better Auth session or generated API key for the browser/API proxy.
# Set true for a managed service; false keeps an anonymous self-hosted demo possible.
AUTH_REQUIRED=false

# Rust router upstream used by the same-origin site proxy.
ROUTER_API_URL=http://localhost:3001
# Master key used only between the site proxy and the Rust gateway.
ROUTER_API_KEY=router_sk_test
# Shared HMAC secret for the short-lived authenticated identity assertion.
# Set the same value as ROUTER_IDENTITY_SECRET in the gateway deployment.
ROUTER_IDENTITY_SECRET=replace-with-a-second-32-character-secret
CHAT_RATE_LIMIT_PER_MINUTE=10
# Authenticated user requests per UTC day. 0 disables the durable quota.
ROUTER_REQUESTS_PER_DAY=0

# Optional managed-service billing. Leave all three unset for self-hosting.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
