# Server-side URL for the Rust router API.
# The browser chat calls /api/chat; this value is read only by the Next server.
# Keep the site and API on different local ports during development.
ROUTER_API_URL=http://localhost:3001

# Master router key used by the server-side /api/chat proxy.
# Never prefix this with NEXT_PUBLIC_: public variables are shipped to browsers.
ROUTER_API_KEY=router_sk_test
